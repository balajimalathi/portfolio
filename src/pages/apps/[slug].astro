---
import PageLayout from "@layouts/PageLayout.astro";
import { apps } from "@data/apps";
import type { AppConfig } from "@types";

export function getStaticPaths() {
  return apps.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

const { app } = Astro.props as { app: AppConfig };
const canonicalUrl = `https://skndan.com/apps/${app.slug}/`;
const ogImageUrl = `https://skndan.com/apps/${app.slug}/og-image.png`;
---

<PageLayout title={`${app.name} — ${app.tagline}`} description={app.description}>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={`{
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "${app.name}",
    "description": "${app.description}",
    "applicationCategory": "${app.category}",
    "operatingSystem": "${app.os}",
    "url": "${canonicalUrl}",
    "author": {
      "@type": "Organization",
      "name": "Skndan"
    },
    "offers": {
      "@type": "Offer",
      "price": "${app.price}",
      "priceCurrency": "USD"
    }
  }`} />

  <style is:inline set:html={`
    .app-landing {
      --app-primary: ${app.theme.primary};
      --app-primary-light: ${app.theme.primaryLight};
      --app-primary-dark: ${app.theme.primaryDark};
      --app-accent: ${app.theme.accent};
      --app-color: ${app.theme.color};
      --app-bg: #fafafa;
      --app-bg-card: #ffffff;
      --app-text: #1a1a2e;
      --app-text-muted: #6b7280;
    }

    .app-landing * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    .app-landing {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', system-ui, sans-serif;
      background: var(--app-bg);
      color: var(--app-text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      position: relative;
    }

    /* Floating background blobs */
    .app-bg-decoration {
      position: fixed;
      border-radius: 50%;
      filter: blur(120px);
      opacity: 0.15;
      pointer-events: none;
      z-index: 0;
    }
    .app-bg--1 {
      width: 500px; height: 500px;
      background: var(--app-primary);
      top: -150px; right: -100px;
      animation: appFloatBlob 20s ease-in-out infinite;
    }
    .app-bg--2 {
      width: 400px; height: 400px;
      background: var(--app-accent);
      bottom: -100px; left: -80px;
      animation: appFloatBlob 25s ease-in-out infinite reverse;
    }
    .app-bg--3 {
      width: 300px; height: 300px;
      background: var(--app-primary-light);
      top: 60%; left: 50%;
      animation: appFloatBlob 18s ease-in-out infinite 5s;
    }

    @keyframes appFloatBlob {
      0%, 100% { transform: translate(0, 0) scale(1); }
      33% { transform: translate(40px, -30px) scale(1.05); }
      66% { transform: translate(-20px, 20px) scale(0.95); }
    }

    .app-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px;
      position: relative;
      z-index: 1;
    }

    /* Hero */
    .app-hero {
      text-align: center;
      padding: 60px 0 40px;
    }
    .app-hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--app-primary-light);
      color: var(--app-primary-dark);
      padding: 6px 18px;
      border-radius: 100px;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 24px;
    }
    .app-hero-badge .app-badge-dot {
      width: 8px; height: 8px;
      background: var(--app-primary);
      border-radius: 50%;
      animation: appPulse 2s ease-in-out infinite;
    }
    @keyframes appPulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(1.3); }
    }
    .app-hero h1 {
      font-size: clamp(2.5rem, 6vw, 4rem);
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.02em;
      margin-bottom: 16px;
    }
    .app-hero .app-gradient-text {
      background: linear-gradient(135deg, var(--app-primary), var(--app-accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .app-hero p {
      font-size: clamp(1.05rem, 2vw, 1.25rem);
      color: var(--app-text-muted);
      max-width: 600px;
      margin: 0 auto 32px;
    }
    .app-hero-actions {
      display: flex;
      gap: 14px;
      justify-content: center;
      flex-wrap: wrap;
    }

    /* Buttons */
    .app-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 28px;
      border-radius: 100px;
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
      transition: all 0.25s;
      cursor: pointer;
      border: none;
      white-space: nowrap;
    }
    .app-btn-primary {
      background: var(--app-primary);
      color: #fff;
      box-shadow: 0 4px 16px color-mix(in srgb, var(--app-primary) 35%, transparent);
    }
    .app-btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 28px color-mix(in srgb, var(--app-primary) 45%, transparent);
    }
    .app-btn-outline {
      background: transparent;
      color: var(--app-primary);
      border: 2px solid var(--app-primary);
    }
    .app-btn-outline:hover {
      background: var(--app-primary);
      color: #fff;
    }

    /* Screenshots */
    .app-section {
      padding: 60px 0;
    }
    .app-section-label {
      text-align: center;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--app-primary);
      margin-bottom: 8px;
    }
    .app-section-title {
      text-align: center;
      font-size: clamp(1.8rem, 4vw, 2.5rem);
      font-weight: 800;
      letter-spacing: -0.01em;
      margin-bottom: 12px;
    }
    .app-section-subtitle {
      text-align: center;
      color: var(--app-text-muted);
      max-width: 500px;
      margin: 0 auto 48px;
    }
    .app-screenshot-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }
    .app-screenshot-card {
      background: var(--app-bg-card);
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 4px 24px rgba(0,0,0,0.06);
      transition: transform 0.3s, box-shadow 0.3s;
    }
    .app-screenshot-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 48px rgba(0,0,0,0.08);
    }
    .app-screenshot-placeholder {
      width: 100%;
      aspect-ratio: 9/16;
      background: linear-gradient(135deg, var(--app-primary-light), color-mix(in srgb, var(--app-accent) 30%, #fff));
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
      color: var(--app-primary-dark);
      font-weight: 600;
      font-size: 0.95rem;
    }
    .app-screenshot-placeholder .app-ph-icon {
      font-size: 3rem;
      opacity: 0.6;
    }
    .app-screenshot-label {
      padding: 16px 20px;
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--app-text);
      text-align: center;
    }

    /* Features */
    .app-features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 24px;
    }
    .app-feature-card {
      background: var(--app-bg-card);
      border-radius: 20px;
      padding: 32px 24px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.06);
      text-align: center;
      transition: transform 0.3s, box-shadow 0.3s;
    }
    .app-feature-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 48px rgba(0,0,0,0.08);
    }
    .app-feature-icon {
      width: 56px;
      height: 56px;
      background: var(--app-primary-light);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      margin: 0 auto 16px;
    }
    .app-feature-card h3 {
      font-weight: 700;
      margin-bottom: 8px;
      font-size: 1.1rem;
    }
    .app-feature-card p {
      color: var(--app-text-muted);
      font-size: 0.9rem;
    }

    /* CTA */
    .app-cta {
      text-align: center;
      padding: 80px 0;
    }
    .app-cta-card {
      background: linear-gradient(135deg, var(--app-primary), var(--app-primary-dark));
      border-radius: 32px;
      padding: 56px 32px;
      color: #fff;
      box-shadow: 0 20px 60px color-mix(in srgb, var(--app-primary) 30%, transparent);
    }
    .app-cta-card h2 {
      font-size: clamp(1.8rem, 4vw, 2.5rem);
      font-weight: 800;
      margin-bottom: 12px;
    }
    .app-cta-card p {
      opacity: 0.9;
      max-width: 500px;
      margin: 0 auto 28px;
      font-size: 1.1rem;
    }
    .app-cta-card .app-btn {
      background: #fff;
      color: var(--app-primary-dark);
      font-weight: 700;
    }
    .app-cta-card .app-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.2);
    }

    /* Footer */
    .app-footer {
      text-align: center;
      padding: 40px 0;
      border-top: 1px solid rgba(0,0,0,0.06);
      color: var(--app-text-muted);
      font-size: 0.85rem;
    }
    .app-footer a {
      color: var(--app-primary);
      text-decoration: none;
      font-weight: 500;
    }
    .app-footer a:hover {
      text-decoration: underline;
    }
    .app-footer-links {
      display: flex;
      justify-content: center;
      gap: 24px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    @media (max-width: 768px) {
      .app-hero { padding: 40px 0 30px; }
      .app-cta-card { padding: 40px 20px; }
    }
  `} />

  <div class="app-landing">
    <!-- Floating blobs -->
    <div class="app-bg-decoration app-bg--1"></div>
    <div class="app-bg-decoration app-bg--2"></div>
    <div class="app-bg-decoration app-bg--3"></div>

    <div class="app-container">
      <!-- Hero -->
      <section class="app-hero">
        <div class="app-hero-badge">
          <span class="app-badge-dot"></span>
          {app.status}
        </div>
        <h1>
          {app.emoji} {app.name}<br />
          <span class="app-gradient-text">{app.tagline}</span>
        </h1>
        <p>{app.description}</p>
        <div class="app-hero-actions">
          {
            app.downloadUrl !== "#" ? (
              <a href={app.downloadUrl} class="app-btn app-btn-primary">🚀 Get Started Free</a>
            ) : (
              <span class="app-btn app-btn-primary" style="cursor:default;opacity:0.8;">🚀 Coming Soon</span>
            )
          }
          <a href="#app-screenshots" class="app-btn app-btn-outline">👀 See Preview</a>
        </div>
      </section>

      <!-- Screenshots -->
      <section class="app-section" id="app-screenshots">
        <p class="app-section-label">✨ Preview</p>
        <h2 class="app-section-title">See {app.name} in action</h2>
        <p class="app-section-subtitle">Beautiful, intuitive, and built for speed. Here's what it looks like.</p>
        <div class="app-screenshot-grid">
          {app.screenshots.map((s, i) => (
            <div class="app-screenshot-card">
              {s.image ? (
                <img src={s.image} alt={s.alt} style="width:100%;aspect-ratio:9/16;object-fit:cover;" />
              ) : (
                <div class="app-screenshot-placeholder">
                  <span class="app-ph-icon">📱</span>
                  <span>Screenshot {i + 1}</span>
                  <span style="font-size:0.8rem;opacity:0.6">Coming soon</span>
                </div>
              )}
              <div class="app-screenshot-label">{s.label}</div>
            </div>
          ))}
        </div>
      </section>

      <!-- Features -->
      <section class="app-section" id="app-features">
        <p class="app-section-label">🌟 Why {app.name}?</p>
        <h2 class="app-section-title">Packed with everything you need</h2>
        <p class="app-section-subtitle">Thoughtfully designed features that make a real difference.</p>
        <div class="app-features-grid">
          {app.features.map((f) => (
            <div class="app-feature-card">
              <div class="app-feature-icon">{f.icon}</div>
              <h3>{f.name}</h3>
              <p>{f.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <section class="app-cta">
        <div class="app-cta-card">
          <h2>Ready to try {app.name}?</h2>
          <p>Join thousands of happy users. It's free to get started — no credit card required.</p>
          {
            app.downloadUrl !== "#" ? (
              <a href={app.downloadUrl} class="app-btn">🚀 Get {app.name} Now</a>
            ) : (
              <span class="app-btn" style="cursor:default;">🚀 Coming Soon</span>
            )
          }
        </div>
      </section>

      <!-- Footer -->
      <footer class="app-footer">
        <div class="app-footer-links">
          <a href="/">Home</a>
          <a href="#app-features">Features</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="https://skndan.com">skndan.com</a>
        </div>
        <p>&copy; {new Date().getFullYear()} {app.name}. Made with ❤️ by <a href="https://skndan.com">Skndan</a></p>
      </footer>
    </div>
  </div>
</PageLayout>
