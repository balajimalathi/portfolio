---
import { getEntry } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { formatDate } from "@lib/utils"

const doc = await getEntry("legal", "readstack-privacy")
if (!doc) {
  throw new Error("Legal entry 'readstack-privacy' not found")
}
const { title, date } = doc.data
const { Content } = await doc.render()
---

<PageLayout title={`ReadStack ${title}`} description={`ReadStack Privacy Policy — a reading habit tracker by Skndan.`}>
  <TopLayout>
    <div class="animate">
      <div class="page-heading">
        ReadStack {title}
      </div>
      <p class="font-normal opacity-75">
        Last updated: {formatDate(date)}
      </p>
    </div>
  </TopLayout>
  <BottomLayout>
    <article class="animate">
      <Content/>
    </article>
  </BottomLayout>
</PageLayout>
