---
type Props = {
  href: string
  badge: string
  alt: string
}

const { href, badge, alt } = Astro.props
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-block transition-opacity hover:opacity-80 blend"
>
  <img src={badge} alt={alt} height="28" loading="lazy" decoding="async" />
</a>
